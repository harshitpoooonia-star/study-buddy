#!/usr/bin/env bash
# Set / rotate the Telegram bot token, Groq key, and your linked Telegram account.
#   ~/moodle-mcp/set-bot-secrets      
# Secrets are typed hidden, checked, and written only to .env (chmod 600).
set -euo pipefail
cd "$(dirname "$(readlink -f "$0")")"
[[ -x .venv-bot/bin/python ]] || { echo "Bot isn't installed yet — run deploy_bot.sh first."; exit 1; }

# The bot must not be polling Telegram while we read updates to find your chat.
sudo systemctl stop study-bot 2>/dev/null || true

if .venv-bot/bin/python bot_setup.py; then
  if [[ -f /etc/systemd/system/study-bot.service ]]; then
    sudo systemctl restart study-bot
    sleep 4
    if systemctl is-active --quiet study-bot; then
      echo "Bot restarted ✅ — open Telegram and send /today."
    else
      echo "Bot failed to start. Last log lines:"; sudo journalctl -u study-bot -n 20 --no-pager
    fi
  fi
else
  echo "No changes applied."
  [[ -f /etc/systemd/system/study-bot.service ]] && sudo systemctl start study-bot || true
  exit 1
fi
